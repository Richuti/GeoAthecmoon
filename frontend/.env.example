# URL del backend (API de Render, backend/api/main.py), sin "/" al final. En Vercel va en
# Settings → Environment Variables. Si el backend no responde en 6 s, la app usa los archivos
# estáticos de public/data, que tienen exactamente los mismos datos (LOLA + JPL Horizons).
# Déjala vacía para usar solo los archivos estáticos.
VITE_API_URL=https://geoathecmoon-api.onrender.com

# Copiloto de rescate (servidor). La clave NO va aquí: este archivo se sube a git.
# Ponla en frontend/.env.local (lo ignora git) y en Vercel → Settings → Environment Variables.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
